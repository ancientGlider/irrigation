{
    "configurations": [
        {
            "name": "Arduino Nano (macOS)",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/lib/**",
                "${env:HOME}/Code/arduino/libraries/**",
                "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.7/cores/arduino",
                "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.7/variants/eightanaloginputs",
                "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.7/libraries/**"
            ],
            "defines": [
                "ARDUINO=10819",
                "ARDUINO_AVR_NANO",
                "ARDUINO_ARCH_AVR",
                "F_CPU=16000000L",
                "__AVR_ATmega328P__"
            ],
            "compilerPath": "${env:HOME}/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-g++",
            "cStandard": "c11",
            "cppStandard": "c++11",
            "intelliSenseMode": "gcc-x64",
            "compilerArgs": [
                "-mmcu=atmega328p",
                "-DF_CPU=16000000L"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}",
                    "${env:HOME}/Code/arduino/libraries",
                    "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.7"
                ],
                "limitSymbolsToIncludedHeaders": false
            }
        }
    ],
    "version": 4
}
